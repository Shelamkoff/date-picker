{
  "name": "@shelamkoff/vue-date-picker",
  "version": "0.1.0",
  "description": "Thin Vue 3 adapter for the framework-agnostic @shelamkoff/date-picker widget.",
  "type": "module",
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm --filter @shelamkoff/date-picker build && npm run typecheck && npm run build"
  },
  "dependencies": { "@shelamkoff/date-picker": "workspace:*" },
  "peerDependencies": { "vue": ">=3.5.0 <4" },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "@types/node": "^22.14.0"
  },
  "license": "MIT",
  "sideEffects": ["**/*.css"]
}
